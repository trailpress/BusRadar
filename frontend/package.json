{
  "name": "busradar-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:routes": "node scripts/verify-gtfs-routes.mjs",
    "preview": "vite preview",
    "realtime:spike": "node scripts/realtime-spike.mjs",
    "simulate:latency": "node scripts/simulate-latency.mjs",
    "gtfs:generate": "node scripts/generate-gtfs-network.mjs",
    "gtfs:runs": "node scripts/generate-scheduled-runs.mjs",
    "gtfs:shard": "node --max-old-space-size=6144 scripts/shard-stop-times.mjs",
    "deploy": "npm run build && gh-pages -d dist --dotfiles --add"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "gtfs-realtime-bindings": "^1.1.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.7.2"
  }
}
