# BusRadar environment placeholders.
# Do not commit real keys or private feed URLs.
# Everything with a VITE_ prefix is embedded in the browser bundle and is
# therefore public. Never put a secret in one.

# --- Realtime ---------------------------------------------------------------

# Base URL of the realtime proxy used by the map. Empty falls back to the
# public Supabase Edge Function, which is what the deployed site uses. Point it
# at another deployment only to test one.
VITE_REALTIME_API_BASE=

# --- Search -----------------------------------------------------------------

# Geocoder used by the address search. Empty falls back to the public
# Nominatim instance of OpenStreetMap, whose usage policy caps the request
# rate. Set your own endpoint if the search has to sustain real traffic.
VITE_GEOCODER_URL=

# --- Route preview ----------------------------------------------------------

# Runtime config endpoint. It returns browser-usable route preview keys from
# Supabase Edge Function secrets, so keys are not committed to GitHub Pages.
VITE_ROUTE_PREVIEW_CONFIG_URL=https://mtuwzlbxhmpnqpaahity.supabase.co/functions/v1/route-preview-config

# auto = Google first when configured, Mapillary fallback/free preview.
# mapillary = Mapillary only. google = Google only.
VITE_ROUTE_PREVIEW_PROVIDER=auto

# Set these in Supabase Edge Function secrets, not in frontend builds:
# GOOGLE_MAPS_API_KEY=
# MAPILLARY_ACCESS_TOKEN=
# ROUTE_PREVIEW_PROVIDER=auto

# --- Realtime diagnostics panel ---------------------------------------------

# Read only by the diagnostics panel, which inspects feeds directly instead of
# going through the proxy. The map does not use these. Keep them empty unless
# the endpoint is authorized and CORS-safe from the browser.
VITE_GTFS_RT_VEHICLE_POSITIONS_URL=
VITE_GTFS_RT_TRIP_UPDATES_URL=
VITE_GTFS_RT_ALERTS_URL=

# --- Dataset generation (Node scripts, not the browser) ---------------------

# Path to an extracted, authorized GTFS static folder containing routes.txt,
# trips.txt, shapes.txt, stops.txt and stop_times.txt. Used by
# `npm run gtfs:generate`.
GTFS_STATIC_DIR=

# Used by `npm run realtime:spike` to inspect the feeds from Node.
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_ALERTS_URL=
GTFS_RT_API_KEY=
