# BusRadar realtime-spike placeholders.
# Do not commit real keys or private feed URLs.

# Path to an extracted, authorized GTFS static folder containing routes.txt,
# trips.txt, shapes.txt, stops.txt and stop_times.txt.
GTFS_STATIC_DIR=

# Future GTFS-Realtime feeds. Keep empty until feed access and license are verified.
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_ALERTS_URL=
GTFS_RT_API_KEY=

# Adapter remains disabled by default. The production UI still uses SimulationAdapter.
VITE_TRANSIT_DATA_MODE=simulation

# Optional: enables the driver route preview with Mapillary as the primary,
# no-Google-cost source. This token is browser-visible: use a token intended
# for public frontend use.
VITE_MAPILLARY_ACCESS_TOKEN=

# auto = Google first when configured, Mapillary fallback/free preview.
# mapillary = Mapillary only. google = Google only.
VITE_ROUTE_PREVIEW_PROVIDER=auto

# Optional fallback: enables Google Street View when Mapillary has no image.
# This is a browser-visible Google Maps key: restrict it in Google Cloud by
# HTTP referrer and allow only the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
